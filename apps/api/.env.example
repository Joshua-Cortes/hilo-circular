# Copia este archivo como .env y ajusta los valores.
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Sin DATABASE_URL la API usa PGlite (PostgreSQL embebido) en PGLITE_DIR: no hay que instalar nada.
# Para usar un PostgreSQL real (local o en la nube), descomenta y completa:
# DATABASE_URL=postgres://usuario:clave@localhost:5432/hilo_circular
PGLITE_DIR=.data/pglite

# Obligatorio en producción. Genera uno con: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET=

# Solo en producción: "true" carga los datos demo (oficios, puntos, prendas y cuentas con clave publicada).
# CARGAR_DEMO=true
